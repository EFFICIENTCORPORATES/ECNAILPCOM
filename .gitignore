# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
scraper/venv/
scraper/.venv/

# ── Environment variables / secrets ──────────────────────────────────────────
.env
.env.local
.env.*.local
*.secret

# ── Playwright browser profile ────────────────────────────────────────────────
# Contains real cookies, cache, session data — never commit this
scraper/browser_profile/

# ── Scraped output (large binary files) ──────────────────────────────────────
# PDFs and logs generated by the scraper — too large for git
trainingdata/scraped/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
desktop.ini

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ── Node (if frontend is added later) ────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ── Database dumps ────────────────────────────────────────────────────────────
*.sql
*.dump
*.db
*.sqlite3
